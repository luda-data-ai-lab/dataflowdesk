# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# One of: sqlite | postgresql | mssql
DB_TYPE=sqlite

# SQLite (default) — file path relative to repo root
SQLITE_PATH=./data/ifmanager.db

# PostgreSQL 15
# Resulting URL: postgresql+asyncpg://user:pass@host:5432/ifmanager
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ifmanager
DB_USER=ifmanager
DB_PASSWORD=change-me

# MS SQL Server
# Resulting URL: mssql+aioodbc://user:pass@host:1433/ifmanager?driver=ODBC+Driver+18+for+SQL+Server
# (set DB_TYPE=mssql, DB_PORT=1433 and the driver name below)
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Or override everything with a full SQLAlchemy URL
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/ifmanager

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Fernet key (AES-128-CBC + HMAC; see QUESTIONS.md) used to encrypt system passwords.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SYSTEM_PASSWORD_KEY=

# JWT — set a long random JWT_SECRET in production
JWT_SECRET=change-me
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Initial admin account created by `python seed.py` (only if it does not exist yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173
